{
  "suite": "item_endpoints_manual",
  "generated_for": "channel-bound item definitions with integer PK",
  "variables": {
    "BASE_URL": "http://localhost:8000",
    "OWNER_CHANNEL_TWITCH_ID": "464887139",
    "OWNER_USER_TWITCH_ID": "464887139",
    "OWNER_USERNAME": "srakjopa",
    "ALT_CHANNEL_TWITCH_ID": "999999001",
    "ALT_USER_TWITCH_ID": "999999001",
    "ALT_USERNAME": "alt_owner"
  },
  "auth": {
    "owner_token": "YOUR_JWT_TOKEN_HERE",
    "alt_token": "<JWT_FOR_999999001_optional_for_channel_isolation_tests>"
  },
  "tests": [
    {
      "id": "01_create_owner_channel_if_missing",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/channels",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "name": "{{OWNER_USERNAME}}"
        }
      },
      "expect": {
        "status_one_of": [
          200,
          400
        ]
      },
      "note": "400 means channel already exists"
    },
    {
      "id": "02_upsert_item_definition_rod",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/definitions",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "item_id": "rod_basic",
          "title": "Basic Rod",
          "description": "Starter rod",
          "type": "equipment",
          "slot": "rod",
          "rarity": "common",
          "durability": 120,
          "stack_size": 1,
          "image_url": "https://example.com/items/rod_basic.png",
          "base_stats": {
            "luck_bonus": 0.05,
            "xp_bonus_pct": 0.03
          }
        }
      },
      "expect": {
        "status": 200,
        "json_contains": {
          "item_id": "rod_basic",
          "channel_twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "title": "Basic Rod"
        }
      }
    },
    {
      "id": "02b_upsert_same_item_definition_updates_existing",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/definitions",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "item_id": "rod_basic",
          "title": "Basic Rod v2",
          "description": "Starter rod updated",
          "type": "equipment",
          "slot": "rod",
          "rarity": "common",
          "durability": 120,
          "stack_size": 1,
          "image_url": "https://example.com/items/rod_basic.png",
          "base_stats": {
            "luck_bonus": 0.05,
            "xp_bonus_pct": 0.03
          }
        }
      },
      "expect": {
        "status": 200,
        "json_contains": {
          "item_id": "rod_basic",
          "channel_twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "title": "Basic Rod v2"
        }
      }
    },
    {
      "id": "03_upsert_item_definition_bait",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/definitions",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "item_id": "bait_worm",
          "title": "Worm Bait",
          "description": "Simple bait",
          "type": "consumable",
          "slot": null,
          "rarity": "common",
          "durability": null,
          "stack_size": 99,
          "image_url": "https://example.com/items/bait_worm.png",
          "base_stats": {
            "luck_bonus": 0.01
          }
        }
      },
      "expect": {
        "status": 200,
        "json_contains": {
          "item_id": "bait_worm",
          "channel_twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "stack_size": 99
        }
      }
    },
    {
      "id": "04_list_item_definitions_for_owner_channel",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/v1/admin/items/definitions?skip=0&limit=50",
        "headers": {
          "Authorization": "Bearer {{owner_token}}"
        }
      },
      "expect": {
        "status": 200,
        "array_contains_item_ids": [
          "rod_basic",
          "bait_worm"
        ]
      }
    },
    {
      "id": "05_update_rewards_pool_with_items",
      "request": {
        "method": "PUT",
        "url": "{{BASE_URL}}/v1/admin/rewards/{{OWNER_CHANNEL_TWITCH_ID}}/default",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "items_drop_rate": 1.0,
          "location_name": "Default Lake",
          "requirements": {
            "level": 1,
            "total_fish_stat": 0,
            "total_mass_stat": 0
          },
          "rewards": [
            {
              "type": "fish",
              "weight": 100,
              "min_mass": 0.1,
              "max_mass": 1.0,
              "xp": 5,
              "message": "{username} caught a fish"
            },
            {
              "type": "fish",
              "weight": 50,
              "min_mass": 0.2,
              "max_mass": 1.2,
              "xp": 4,
              "message": "{username} caught another fish"
            }
          ],
          "items": [
            {
              "item_id": "rod_basic",
              "weight": 70,
              "xp_gain": 15,
              "quantity": null,
              "message": "{username} found a rod"
            },
            {
              "item_id": "bait_worm",
              "weight": 30,
              "xp_gain": 3,
              "quantity": 100,
              "message": "{username} found bait"
            }
          ]
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "06_get_rewards_pool_and_validate_item_ids",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/v1/admin/rewards/{{OWNER_CHANNEL_TWITCH_ID}}/default",
        "headers": {
          "Authorization": "Bearer {{owner_token}}"
        }
      },
      "expect": {
        "status": 200,
        "items_array_contains_item_ids": [
          "rod_basic",
          "bait_worm"
        ]
      }
    },
    {
      "id": "07_grant_item_to_owner_player",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/grant",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "channel_twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "user_twitch_id": "{{OWNER_USER_TWITCH_ID}}",
          "item_id": "rod_basic",
          "quantity": 1,
          "slot_id": null,
          "current_durability": 115,
          "meta": {
            "source": "manual_test"
          }
        }
      },
      "expect": {
        "status": 200,
        "json_contains": {
          "success": true,
          "item": {
            "item_id": "rod_basic",
            "title": "Basic Rod v2"
          }
        }
      }
    },
    {
      "id": "08_get_inventory_from_admin_endpoint",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/v1/admin/players/{{OWNER_CHANNEL_TWITCH_ID}}/{{OWNER_USER_TWITCH_ID}}/inventory",
        "headers": {
          "Authorization": "Bearer {{owner_token}}"
        }
      },
      "expect": {
        "status": 200,
        "items_array_contains_item_ids": [
          "rod_basic"
        ]
      }
    },
    {
      "id": "09_get_inventory_public_endpoint",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/v1/inventory/{{OWNER_CHANNEL_TWITCH_ID}}/{{OWNER_USER_TWITCH_ID}}"
      },
      "expect": {
        "status": 200,
        "items_array_contains_item_ids": [
          "rod_basic"
        ]
      }
    },
    {
      "id": "10_equip_rod",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/inventory/equip",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "user_id": "{{OWNER_USER_TWITCH_ID}}",
          "channel_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "slot_id": 1
        }
      },
      "expect": {
        "status": 200,
        "json_contains": {
          "success": true
        }
      }
    },
    {
      "id": "11_fish_once_and_verify_response",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/fish",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "user_id": "{{OWNER_USER_TWITCH_ID}}",
          "username": "{{OWNER_USERNAME}}",
          "channel_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "user_input": null,
          "is_mod": false,
          "is_sub": false
        }
      },
      "expect": {
        "status": 200
      },
      "note": "item drop is random unless items_drop_rate=1 and pool allows drop"
    },
    {
      "id": "12_negative_grant_unknown_item",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/grant",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "channel_twitch_id": "{{OWNER_CHANNEL_TWITCH_ID}}",
          "user_twitch_id": "{{OWNER_USER_TWITCH_ID}}",
          "item_id": "missing_item_404",
          "quantity": 1,
          "slot_id": null,
          "current_durability": null,
          "meta": {}
        }
      },
      "expect": {
        "status": 404
      }
    },
    {
      "id": "13_negative_rewards_with_unknown_item",
      "request": {
        "method": "PUT",
        "url": "{{BASE_URL}}/v1/admin/rewards/{{OWNER_CHANNEL_TWITCH_ID}}/default",
        "headers": {
          "Authorization": "Bearer {{owner_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "items_drop_rate": 1.0,
          "location_name": "Default Lake",
          "requirements": {
            "level": 1,
            "total_fish_stat": 0,
            "total_mass_stat": 0
          },
          "rewards": [
            {
              "type": "fish",
              "weight": 100,
              "min_mass": 0.1,
              "max_mass": 1.0,
              "xp": 5,
              "message": "{username} caught a fish"
            },
            {
              "type": "nothing",
              "weight": 1,
              "message": "fallback"
            }
          ],
          "items": [
            {
              "item_id": "missing_item_404",
              "weight": 100,
              "xp_gain": 0,
              "quantity": null,
              "message": "should fail"
            },
            {
              "item_id": "missing_item_404_b",
              "weight": 1,
              "xp_gain": 0,
              "quantity": null,
              "message": "should fail 2"
            }
          ]
        }
      },
      "expect": {
        "status": 404
      }
    },
    {
      "id": "14_channel_isolation_same_item_id_alt_channel",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v1/admin/items/definitions",
        "headers": {
          "Authorization": "Bearer {{alt_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "item_id": "rod_basic",
          "title": "ALT Rod",
          "description": "Must not affect owner channel",
          "type": "equipment",
          "slot": "rod",
          "rarity": "rare",
          "durability": 999,
          "stack_size": 1,
          "image_url": null,
          "base_stats": {
            "luck_bonus": 0.5
          }
        }
      },
      "expect": {
        "status_one_of": [
          200,
          401,
          403
        ]
      },
      "note": "Run only if you have second channel token"
    },
    {
      "id": "15_channel_isolation_owner_list_still_owner_items",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/v1/admin/items/definitions?skip=0&limit=50",
        "headers": {
          "Authorization": "Bearer {{owner_token}}"
        }
      },
      "expect": {
        "status": 200,
        "json_should_not_contain_title": "ALT Rod"
      },
      "note": "Confirms per-channel isolation"
    }
  ]
}
