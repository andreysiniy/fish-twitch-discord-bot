# Local-only E2E runner settings. Copy to .env.e2e and keep the copy uncommitted.
# Use dedicated Twitch test accounts and a dedicated test channel.

TWITCH_E2E_ENABLED=true
TWITCH_E2E_MODE=stub
# The provider mode controls StreamElements; transport remains real so the
# production bot_gateway and game_engine path are exercised through Twitch.
TWITCH_E2E_TRANSPORT=real
TWITCH_E2E_CHANNEL=replace_with_dedicated_test_channel
TWITCH_E2E_CHANNEL_ID=replace_with_twitch_channel_user_id
TWITCH_E2E_BOT_LOGIN=replace_with_e2e_bot_login
TWITCH_E2E_BOT_USER_ID=replace_with_e2e_bot_user_id
TWITCH_E2E_CLIENT_ID=replace_with_twitch_e2e_client_id
TWITCH_E2E_CLIENT_SECRET=replace_with_twitch_e2e_client_secret
TWITCH_E2E_ENGINE_API_KEY=replace_with_e2e_engine_api_key
TWITCH_E2E_RUNNER_API_KEY=replace_with_e2e_runner_api_key
TWITCH_E2E_RESULT_DB=/tmp/twitch_e2e_runs.sqlite3
# Real Twitch chat is eventually consistent and rate-limited. These values
# keep the runner from treating a delayed production reply as a test failure.
TWITCH_E2E_COMMAND_TIMEOUT=45
TWITCH_E2E_ECHO_TIMEOUT=3
TWITCH_E2E_ACTOR_START_TIMEOUT=90
TWITCH_E2E_SEND_INTERVAL=1.6
TWITCH_E2E_IRC_RETRY_LIMIT=3

# The stub is used by deterministic local runs. Set the provider URL to the
# real StreamElements API only for a dedicated, explicitly authorized test.
TWITCH_E2E_STUB_URL=http://streamelements_stub:8080
STREAMELEMENTS_API_BASE_URL=http://streamelements_stub:8080
STREAMELEMENTS_STUB_CONTROL_KEY=replace_with_e2e_stub_control_key
TESTING_API_ENABLED=true

# Four dedicated Twitch identities used by the real transport scenarios.
TWITCH_E2E_OWNER_USER_ID=replace_with_owner_user_id
TWITCH_E2E_OWNER_LOGIN=replace_with_owner_login
TWITCH_E2E_OWNER_ACCESS_TOKEN=replace_with_owner_access_token
TWITCH_E2E_OWNER_REFRESH_TOKEN=replace_with_owner_refresh_token
TWITCH_E2E_EDITOR_USER_ID=replace_with_editor_user_id
TWITCH_E2E_EDITOR_LOGIN=replace_with_editor_login
TWITCH_E2E_EDITOR_ACCESS_TOKEN=replace_with_editor_access_token
TWITCH_E2E_EDITOR_REFRESH_TOKEN=replace_with_editor_refresh_token
TWITCH_E2E_VIEWER1_USER_ID=replace_with_viewer1_user_id
TWITCH_E2E_VIEWER1_LOGIN=replace_with_viewer1_login
TWITCH_E2E_VIEWER1_ACCESS_TOKEN=replace_with_viewer1_access_token
TWITCH_E2E_VIEWER1_REFRESH_TOKEN=replace_with_viewer1_refresh_token
TWITCH_E2E_VIEWER2_USER_ID=replace_with_viewer2_user_id
TWITCH_E2E_VIEWER2_LOGIN=replace_with_viewer2_login
TWITCH_E2E_VIEWER2_ACCESS_TOKEN=replace_with_viewer2_access_token
TWITCH_E2E_VIEWER2_REFRESH_TOKEN=replace_with_viewer2_refresh_token
